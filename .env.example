# Copy to .env.local for development. Set the same names in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# --- Site -------------------------------------------------------------------
# "production" only on the live site: enables indexing, hides draft items.
NEXT_PUBLIC_SITE_ENV=

# --- Bookings ---------------------------------------------------------------
# 'whatsapp' (default): /book sends a WhatsApp request, nothing is stored.
# 'database': live free times, bookings stored in Supabase, Paystack payments
#             for services that take them. Needs everything below.
# Read at build time by /book, so redeploy after changing it.
BOOKINGS_MODE=whatsapp

# --- Supabase (Project Settings > API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: read-only access to the catalogue under RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (Settings > API Keys & Webhooks) ------------------------------
# SERVER ONLY. sk_test_… on previews, sk_live_… in production. Also signs
# webhooks. Webhook URL: https://www.kikiewa.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# --- Cron -------------------------------------------------------------------
# Any long random string. Vercel sends it to /api/cron/expire-holds.
CRON_SECRET=

# --- Tests only (.env.test.local), a separate Supabase test project ----------
# TEST_SUPABASE_URL=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
# TEST_SUPABASE_ANON_KEY=
